{
  "name": "@smeflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for SMEFlow AI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
